#version 450

const float PI = 3.1415926536;

// layout (location = 0) in vec2 inUV;

// layout (location = 0) out vec4 outColor;

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rg16f) uniform writeonly image2D uBrdfLUT;

// layout (constant_id = 0) const uint SAMPLE_COUNT = 1024u;

const uint  SAMPLE_COUNT = 1024u;

// https://learnopengl.com/code_viewer_gh.php?code=src/6.pbr/2.2.2.ibl_specular_textured/2.2.2.brdf.fs


// Based omn http://byteblacksmith.com/improvements-to-the-canonical-one-liner-glsl-rand-for-opengl-es-2-0/
float Random(vec2 co)
{
	float a  = 12.9898;
	float b  = 78.233;
	float c  = 43758.5453;
	float dt = dot(co.xy ,vec2(a, b));
	float sn = mod(dt, 3.14);

	return fract(sin(sn) * c);
}

// Radical inverse based on Van Der Corput sequence
float RadicalInverse_VdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);

    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N)
{
    return vec2(float(i) / float(N), RadicalInverse_VdC(i));
}

