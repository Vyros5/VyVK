// {
// 	outColor = vec4(BRDF(inUV.s, 1.0 - inUV.t), 0.0, 1.0);
// }



void main()
{
    ivec2 pos     = ivec2(gl_GlobalInvocationID.xy);
    vec2  texSize = vec2(imageSize(uBrdfLUT));

    // Avoid edge cases at 0
    float NdotV     = max((float(pos.x) + 0.5) / texSize.x, 0.001);
    float roughness = max((float(pos.y) + 0.5) / texSize.y, 0.001);

    vec2 brdf = IntegrateBRDF(NdotV, roughness);

    imageStore(uBrdfLUT, pos, vec4(brdf, 0.0, 1.0));
}